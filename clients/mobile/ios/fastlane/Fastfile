default_platform(:ios)

platform :ios do
  desc "Descarga certificados de distribución y aprovisionamiento, compila y sube versión a TestFlight"
  lane :beta do
    # 1. Asegurar certificados actualizados mediante match (Certificados compartidos en repo seguro)
    match(type: "appstore", readonly: true)

    # 2. Incrementar automáticamente el número de build nativo
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || "1"
    )

    # 3. Compilar el archivo .ipa de producción
    gym(
      scheme: "AseguraPatrimonio",
      workspace: "AseguraPatrimonio.xcworkspace",
      output_directory: "./build",
      output_name: "AseguraPatrimonio.ipa",
      clean: true,
      configuration: "Release"
    )

    # 4. Enviar a TestFlight para pruebas internas de calidad
    pilot(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Compilar y enviar versión estable final a la App Store Connect para revisión oficial"
  lane :release do
    # 1. Sincronizar perfiles de distribución
    match(type: "appstore", readonly: true)

    # 2. Incrementar versión de compilación
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || "1"
    )

    # 3. Compilar ipa optimizado de producción
    gym(
      scheme: "AseguraPatrimonio",
      workspace: "AseguraPatrimonio.xcworkspace",
      output_directory: "./build",
      output_name: "AseguraPatrimonio-Release.ipa",
      clean: true
    )

    # 4. Subir binarios directamente a App Store Connect
    deliver(
      submit_for_review: false, # Cambiar a true para automatizar la solicitud de revisión
      skip_metadata: false,     # Subir descripción, capturas de pantalla, etc.
      skip_screenshots: true    # Omitir si las capturas de pantalla ya se gestionan manualmente
    )
  end
end
